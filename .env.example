# Salin ke .env hanya kalau mau tes lokal dengan `vercel dev`.
# Untuk produksi, isi lewat Vercel > Project > Settings > Environment Variables.
# JANGAN commit file .env yang sudah berisi nilai asli.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
DEVICE_TOKEN=isi-string-acak-panjang-untuk-esp32
ADMIN_PASSWORD=isi-password-admin-yang-kuat
SESSION_SECRET=isi-string-acak-panjang-lain

# Opsional: 1 = tampilkan detail error di respons API (hanya saat debugging)
# DEBUG_ERRORS=1
